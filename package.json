{
  "name": "pyre-lang",
  "version": "1.0.0",
  "description": "Pyre: a typed GPU language (GLSL/WGSL/JS) plus Pyre Torch, a PyTorch-style tensor and autograd library for the CPU.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js",
    "./png": "./src/png.js",
    "./package.json": "./package.json",
    "./torch": "./src/torch/index.js"
  },
  "bin": {
    "pyre": "./bin/pyre.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node bin/pyre.js check examples/*.pyre",
    "gpu-check": "node scripts/gpu-check.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "autograd",
    "compiler",
    "glsl",
    "gpgpu",
    "gpu",
    "language",
    "machine-learning",
    "neural-network",
    "pytorch",
    "shader",
    "shader-language",
    "tensor",
    "webgl",
    "webgpu",
    "wgsl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tharunmaks/Pyre.git"
  },
  "homepage": "https://github.com/Tharunmaks/Pyre#readme"
}
